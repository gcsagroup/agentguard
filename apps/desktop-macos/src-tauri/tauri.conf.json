{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentGuard",
  "version": "1.0.0-rc.1",
  "identifier": "com.agentguard.desktop.macos",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentGuard macOS",
        "width": 1180,
        "height": 820,
        "minWidth": 680,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../setup-assets/": "agentguard/setup/",
      "../../../crates/guard-schema/rules/p0_rules.yaml": "agentguard/rules/p0_rules.yaml",
      "../../../policies/pro-trial.yaml": "agentguard/policies/pro-trial.yaml",
      "../../../policies/task-plans.yaml": "agentguard/policies/task-plans.yaml",
      "../../../intel/bundle.json": "agentguard/intel/bundle.json",
      "../../../intel/keys/public.hex": "agentguard/intel/public.hex",
      "../../protected-browser/cli.mjs": "agentguard/protected-browser/cli.mjs",
      "../../protected-browser/runtime.mjs": "agentguard/protected-browser/runtime.mjs",
      "../../protected-browser/execution-contract.mjs": "agentguard/protected-browser/execution-contract.mjs",
      "../../protected-browser/host-connection.mjs": "agentguard/protected-browser/host-connection.mjs",
      "../../protected-browser/mcp.mjs": "agentguard/protected-browser/mcp.mjs",
      "../../protected-browser/tools.json": "agentguard/protected-browser/tools.json",
      "../../protected-browser/agent-bridge.mjs": "agentguard/protected-browser/agent-bridge.mjs",
      "../../protected-browser/guardian.mjs": "agentguard/protected-browser/guardian.mjs",
      "../../protected-browser/control.html": "agentguard/protected-browser/control.html",
      "../../protected-browser/control.js": "agentguard/protected-browser/control.js",
      "../../extension-chromium/": "agentguard/extension-chromium/",
      "../../protected-browser/demo.mjs": "agentguard/protected-browser/demo.mjs"
    },
    "macOS": {
      "bundleVersion": "22",
      "minimumSystemVersion": "12.3",
      "entitlements": "./entitlements.plist",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
