<?xml version="1.0" encoding="utf-8"?>
<!--
  开发构建的中继可通过 adb reverse 访问 127.0.0.1 明文 HTTP；LAN 端点必须使用 HTTPS。
  API 28 起默认禁止明文传输，隐式 localhost 例外直到 API 37 才出现，因此仅明确放行 127.0.0.1。
  实际端点还要通过 RelayTransport.endpoint 校验：明文 HTTP 只接受 127.0.0.1。
  其余目标继续禁止明文传输。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
