<?xml version="1.0" encoding="utf-8"?>
<!--
  The envelope relay targets the desktop over `adb reverse` loopback (or a
  user-configured LAN address) in plain HTTP. From API 28 the default base config
  is cleartextTrafficPermitted="false", and the implicit localhost exemption only
  exists from API 37 — so without this file the relay POST fails, and RelayClient
  swallows the error, leaving the engine silently unreachable.

  Scoped to loopback only: everything else stays cleartext-denied.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
