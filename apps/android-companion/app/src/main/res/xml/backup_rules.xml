<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的 Auto Backup 规则:与 data_extraction_rules.xml 同义——全部排除。 -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
