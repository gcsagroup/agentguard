{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "agentguard@agentguard.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "payment_shape_block",
        "enabled": true,
        "path": "rules/payment-shape-block.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["guard-gate.js", "guard-strings.js", "guard-modal.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
